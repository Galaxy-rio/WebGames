{
  "name": "galaxyrio-web-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "leaderboard:dev": "npm --prefix services/leaderboard run dev",
    "leaderboard:setup": "node services/leaderboard/scripts/setup-local.mjs",
    "test:leaderboard": "npm --prefix services/leaderboard test"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "colorjs.io": "^0.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
